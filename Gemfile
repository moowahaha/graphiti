  gem 'minitest-display'
end

group :development do
  gem 'sinatra-reloader', '>= 1.0', :require => 'sinatra/reloader'
  gem 'thin'
  gem 'ruby-debug19'
end

group :production do
  gem 'unicorn', '>= 5.1.0'
end
