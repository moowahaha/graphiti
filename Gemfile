gem 'sinatra-contrib', '>= 2.0.0'
gem 'jim', '>= 0.3.2'
gem 'closure-compiler'
gem 'redis'
gem 'redis-namespace'
gem 'compass'
gem 'haml'
gem 'typhoeus'
gem 'yajl-ruby'
gem 'pony'

